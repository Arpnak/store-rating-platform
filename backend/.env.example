# ─── Database ───────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=store_rating_db
DB_USER=your_postgres_user
DB_PASSWORD=your_postgres_password

# ─── Auth ────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# ─── Server ──────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── CORS ────────────────────────────────────────────────────
CLIENT_URL=http://localhost:3000
